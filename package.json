{
  "name": "aa-recorder",
  "version": "1.0.0",
  "description": "Analytics Ads Recorder - Capture and analyze Google Analytics 4 events with Electron and Playwright",
  "author": "Scott",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thehouseofbailey/aa-recorder"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "concurrently -n UI,MAIN \"npm run dev:ui\" \"npm run dev:electron\"",
    "dev:ui": "vite",
    "dev:electron": "cross-env NODE_ENV=development ts-node ./scripts/dev-electron.ts",
    "compile": "esbuild src/main/main.ts src/main/preload.ts src/recorder/Recorder.ts src/recorder/RecorderManager.ts src/recorder/csvHelpers.ts src/recorder/parseGa4.ts src/recorder/urlMatchers.ts --platform=node --format=cjs --outdir=dist --sourcemap",
    "build": "npm run compile && vite build && electron-builder",
    "build:win": "npm run compile && vite build && electron-builder --win portable",
    "build:linux": "npm run compile && vite build && electron-builder --linux AppImage",
    "build:mac": "npm run compile && vite build && electron-builder --mac dmg",
    "build:all": "npm run compile && vite build && electron-builder --win portable --linux AppImage --mac dmg",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --dir src",
    "test:integration": "vitest run --dir test",
    "lint": "eslint .",
    "audit-fix": "npm audit fix --force"
  },
  "build": {
    "appId": "com.mmi.aa.recorder",
    "productName": "AA-Recorder",
    "asar": true,
    "publish": [],
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "artifactName": "AA-Recorder-${version}-portable.exe",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "artifactName": "AA-Recorder-${version}.AppImage",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "AA-Recorder-${version}.dmg",
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "node_modules/playwright/.local-browsers",
        "to": ".local-browsers",
        "filter": ["**/*"]
      }
    ]
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-window": "^1.8.10"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.0.0",
    "happy-dom": "^20.0.11",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "electron",
    "playwright",
    "recorder",
    "analytics",
    "ads"
  ]
}
